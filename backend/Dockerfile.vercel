# Vercel Fluid / Services container image for the Spring Boot API.
# Vercel routes to port 80 by default (override with project env PORT).
# ---- build stage ----
FROM maven:3.9.16-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -q dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

# ---- runtime stage ----
FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /build/target/securetravels-crm-0.1.0.jar app.jar
RUN chown -R 1000:1000 /app
USER 1000
ENV PORT=80
EXPOSE 80
# Bind all interfaces so the Vercel ingress can reach the process.
ENTRYPOINT ["java", "-Dserver.address=0.0.0.0", "-jar", "/app/app.jar"]
