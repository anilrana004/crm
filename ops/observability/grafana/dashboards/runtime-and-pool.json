{
  "uid": "st-runtime",
  "title": "SecureTravels - Runtime and Connection Pool",
  "description": "JVM health and HikariCP connection pool utilisation. Covers the 'database connection pool utilization' and 'JVM health' requirements of Phase 3 Module 5.",
  "tags": ["securetravels", "jvm", "hikari"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Connection pool utilisation",
      "description": "Active connections against the pool maximum. The pool is at 10 in the default configuration, so this saturates quickly under load.",
      "datasource": { "type": "prometheus", "uid": "securetravels-prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active / clamp_min(hikaricp_connections_max, 1)",
          "legendFormat": "utilisation"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Connection pool: active / idle / pending",
      "description": "pending > 0 sustained is the real exhaustion signal: threads are blocked waiting for a connection.",
      "datasource": { "type": "prometheus", "uid": "securetravels-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "refId": "D", "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "JVM heap used",
      "datasource": { "type": "prometheus", "uid": "securetravels-prometheus" },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{area=\"heap\"}), 1)",
          "legendFormat": "heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red", "value": 0.85 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heap by pool",
      "datasource": { "type": "prometheus", "uid": "securetravels-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "sum by (id) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used {{id}}" },
        { "refId": "B", "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max (all pools)" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "lineWidth": 1, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Live threads",
      "description": "A rising line with no matching rise in traffic suggests a thread leak.",
      "datasource": { "type": "prometheus", "uid": "securetravels-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "jvm_threads_live_threads", "legendFormat": "live" },
        { "refId": "B", "expr": "jvm_threads_daemon_threads", "legendFormat": "daemon" },
        { "refId": "C", "expr": "jvm_threads_peak_threads", "legendFormat": "peak" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 400 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Process CPU and uptime",
      "datasource": { "type": "prometheus", "uid": "securetravels-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 7 },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage", "legendFormat": "cpu" },
        { "refId": "B", "expr": "process_resident_memory_bytes", "legendFormat": "rss" }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [{ "matcher": { "id": "byName", "options": "cpu" }, "properties": [{ "id": "unit", "value": "percentunit" }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
